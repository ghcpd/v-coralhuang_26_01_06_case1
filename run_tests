#!/usr/bin/env python3
"""
One-click test script for mini_humanize.
Installs dependencies if missing and runs the test suite.
"""
import subprocess
import sys

def main():
    # Check if pytest is installed
    try:
        import pytest
    except ImportError:
        print("Installing test dependencies...")
        subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'pytest', 'pytest-cov'])
    
    # Run pytest
    print("Running tests...")
    result = subprocess.run([sys.executable, '-m', 'pytest'], cwd="c:\\Bug_Bash\\26_01_06\\1\\grok-fast")
    sys.exit(result.returncode)

if __name__ == "__main__":
    main()